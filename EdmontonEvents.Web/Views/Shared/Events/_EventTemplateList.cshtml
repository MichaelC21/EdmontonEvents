@using EdmontonEvents.Web.Models;
@model EventDTO

<div class="event-listing-card rounded-4">
    <div class="event-listing-card__content">
        <div class="event-listing-card__top">
            <span class="event-listing-card__eyebrow">Upcoming event</span>
            <span class="event-listing-card__meta">@Model.EventStartDate.ToString("MMMM dd, yyyy • h:mm tt")</span>
        </div>

        <h3 class="event-listing-card__title">@Model.Title</h3>
        <p class="event-listing-card__meta">@Model.Location</p>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="event-listing-card__description">@Model.Description</p>
        }
    </div>

    <div class="event-listing-card__actions">
        @if (Model.Price.HasValue)
        {
            <div class="event-listing-card__price">$@Model.Price.Value.ToString("0.00")</div>
        }
        <a class="btn btn-primary px-4" asp-action="View_Event" asp-route-id="@Model.EventID">Sign up</a>
    </div>
</div>
