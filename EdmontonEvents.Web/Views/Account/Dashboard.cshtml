@using EdmontonEvents.Web.Models
@model AccountDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@section Styles
{
    <link rel="stylesheet" type="text/css" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-hero py-5">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-8">
                <p class="text-uppercase text-sea-green fw-bold mb-2">Welcome back, @Model.FullName</p>
                <h1 class="display-6 fw-bold text-dark-teal">Your Edmonton Events Dashboard</h1>
                <p class="lead text-muted mb-4">Track upcoming events, review your RSVP status, and manage your event activity from one place.</p>
                <div class="d-flex flex-column flex-sm-row gap-2">
                    <a asp-controller="Account" asp-action="Dashboard" class="btn btn-brand btn-lg">View schedule</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-lg">Explore events</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="dashboard-summary p-4 rounded-4 shadow-sm bg-white">
                    <p class="text-uppercase text-dark-teal fw-bold mb-3">Quick summary</p>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h3 class="mb-0">8</h3>
                            <small class="text-muted">Upcoming events</small>
                        </div>
                        <span class="badge bg-sea-green rounded-pill py-2 px-3">On track</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h3 class="mb-0">3</h3>
                            <small class="text-muted">RSVPs pending</small>
                        </div>
                        <span class="badge bg-tea-green rounded-pill py-2 px-3">Action needed</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-0">12</h3>
                            <small class="text-muted">Saved events</small>
                        </div>
                        <span class="badge bg-celadon rounded-pill py-2 px-3">Saved</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="dashboard-main py-5">
    <div class="container">
        <div class="row gy-4">
            <div class="col-xl-8">
                <div class="card dashboard-card shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <h2 class="h5 fw-bold mb-1">Upcoming events</h2>
                                <p class="text-muted mb-0">Events you're attending or watching this month.</p>
                            </div>
                            <a class="text-decoration-none text-sea-green" href="#">See all</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="text-muted small text-uppercase">
                                    <tr>
                                        <th>Event</th>
                                        <th>Date</th>
                                        <th>Location</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>River Valley Festival</strong><br /><small class="text-muted">Family-friendly arts & music</small></td>
                                        <td>June 24, 2026</td>
                                        <td>Laurier Park</td>
                                        <td><span class="badge bg-sky-surge text-white">Going</span></td>
                                        <td><a class="btn btn-sm btn-outline-dark w-100" href="#">View</a></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Night Market</strong><br /><small class="text-muted">Food, craft stalls, live DJs</small></td>
                                        <td>June 29, 2026</td>
                                        <td>Old Strathcona</td>
                                        <td><span class="badge bg-tea-green text-dark">Interested</span></td>
                                        <td><a class="btn btn-sm btn-outline-dark w-100" href="#">RSVP</a></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Summer Trail Run</strong><br /><small class="text-muted">5K run along the river valley</small></td>
                                        <td>July 5, 2026</td>
                                        <td>Whitemud Creek</td>
                                        <td><span class="badge bg-vanilla-cream text-dark">Saved</span></td>
                                        <td><a class="btn btn-sm btn-outline-dark w-100" href="#">Details</a></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="card dashboard-card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Event highlights</h2>
                        <div class="mb-3">
                            <p class="mb-2 fw-semibold">City concerts</p>
                            <div class="progress" style="height: .65rem;">
                                <div class="progress-bar bg-sea-green" role="progressbar" style="width: 76%;" aria-valuenow="76" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <p class="mb-2 fw-semibold">Food festivals</p>
                            <div class="progress" style="height: .65rem;">
                                <div class="progress-bar bg-celadon" role="progressbar" style="width: 58%;" aria-valuenow="58" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                        <div>
                            <p class="mb-2 fw-semibold">Outdoor markets</p>
                            <div class="progress" style="height: .65rem;">
                                <div class="progress-bar bg-sky-surge" role="progressbar" style="width: 84%;" aria-valuenow="84" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <div class="row gy-4">
            <div class="col-xl-8">
                <div class="card dashboard-card shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <h2 class="h5 fw-bold mb-1">Listed events</h2>
                                <p class="text-muted mb-0">View and manage the events you have listed.</p>
                            </div>
                            <a class="text-decoration-none text-sea-green" href="#">See all</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle mb-0 text-center">
                                <thead class="text-muted small text-uppercase">
                                    <tr>
                                        <th>Event</th>
                                        <th>Date</th>
                                        <th>Location</th>
                                        <th>Attendees</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>River Valley Festival</strong><br /><small class="text-muted">Family-friendly arts & music</small></td>
                                        <td>June 24, 2026</td>
                                        <td>Laurier Park</td>
                                        <td class="fw-bold text-uppercase fs-5">50</td>
                                        <td><a class="btn btn-sm btn-outline-dark w-100" href="#">View</a></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Night Market</strong><br /><small class="text-muted">Food, craft stalls, live DJs</small></td>
                                        <td>June 29, 2026</td>
                                        <td>Old Strathcona</td>
                                        <td class="fw-bold text-uppercase fs-5">2.5k</td>
                                        <td><a class="btn btn-sm btn-outline-dark w-100" href="#">RSVP</a></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Summer Trail Run</strong><br /><small class="text-muted">5K run along the river valley</small></td>
                                        <td>July 5, 2026</td>
                                        <td>Whitemud Creek</td>
                                        <td class="fw-bold text-uppercase fs-5">100</td>
                                        <td><a class="btn btn-sm btn-outline-dark w-100" href="#">Details</a></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="card dashboard-card shadow-sm border-0 mb-4 h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Actions</h2>
                        <div class="list-group list-group-flush">
                            <a href="#" class="list-group-item list-group-item-action border-0 px-0 py-3">Create a new event</a>
                            <a href="#" class="list-group-item list-group-item-action border-0 px-0 py-3">Review attendee RSVPs</a>
                            <a href="#" class="list-group-item list-group-item-action border-0 px-0 py-3">Update your profile</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


