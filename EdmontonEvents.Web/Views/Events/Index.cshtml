@using EdmontonEvents.Web.Models
@model List<EventDTO>
@{
    ViewData["Title"] = "Events";
}
@section Styles {
    <link rel="stylesheet" href="~/css/event.css" />
}
<section class="position-relative overflow-hidden w-100" style="background-color: var(--dark-teal); max-width: 100%; margin: 0;">
    <img src="~/imgs/RiverValley.webp" alt="River Valley in Edmonton" class="w-100 opacity-50" style="max-height: 420px; object-fit: cover; object-position: center 20%;" />
    <div class="w-100 h-100 d-flex align-items-center">
        <div class="container py-5">
            <div class="col-lg-7 text-vanilla-cream">
                <h1 class="text-uppercase fw-bold mb-2" style="letter-spacing: .12rem; color: var(--celadon);">Explore Edmonton</h1>
                <h3 class="display-4 fw-bold mb-3">Find local events happening around the city.</h3>
                <p class="lead mb-4">Browse upcoming gatherings in the river valley and beyond.</p>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-lg fw-semibold" style="background-color: var(--celadon); color: var(--dark-teal);" asp-controller="Events" asp-action="Create">Submit an Event</a>
                    <a class="btn btn-lg btn-outline-light" asp-controller="Home" asp-action="Index">Back Home</a>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container my-4">
    <div class="d-flex flex-column gap-3">
        @foreach (var eventDTO in Model)
        {
            <partial name="~/Views/Shared/Events/_EventTemplateList.cshtml" model="eventDTO" />
        }
    </div>
</div>
